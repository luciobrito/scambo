# Copie este arquivo para .env e ajuste se necessário (o ./dev.sh faz a cópia se ele não existir).

# Endereço da API (backend/ScamboApi, perfil "http"). Mantenha a barra no final.
VITE_API_URL=http://localhost:5209/

# Dados de exemplo (frontend/src/services/mocks/). Mude para false quando os endpoints do
# módulo estiverem prontos no back-end; as telas passam a usar a API real.

# GET api/usuarios/me, GET api/usuarios/me/perfil e PATCH api/usuarios/me
VITE_MOCK_USUARIO=true

# Endpoints de api/chat
VITE_MOCK_CHAT=true
